NODE_ENV=development


# Dev-режим работает по HTTPS: Vite берёт mkcert-серты из src/back/dev-certs,
# они покрывают 192.168.1.59 — поэтому доступ по LAN идёт по https.
# В electron HTTPS включён по умолчанию; отключить можно явно флагом JESMYL_DEV_IS_HTTPS=0.
VITE_IS_HTTPS=1
VITE_DNS=192.168.1.59

VITE_SOKI_POSTFIX=:4446

VITE_AUTH_IDB_STORE_NAME=authorization