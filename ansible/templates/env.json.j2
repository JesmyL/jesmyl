{
  "DB_USER": {{ DB_USER | to_json }},
  "DB_PASSWORD": {{ DB_PASSWORD | to_json }},
  "DB_NAME": {{ DB_NAME | to_json }},
  "DB_PORT": {{ DB_PORT | to_json }},
  "DB_HOST": {{ DB_HOST | to_json }},
  "SECURE_KEY": {{ SECURE_KEY | to_json }},
  "isProd": {{ 'true' if (isProd | string | lower) in ['true', '1', 'yes'] else 'false' }},
  "subdomain": {{ subdomain | default('') | to_json }}
}
